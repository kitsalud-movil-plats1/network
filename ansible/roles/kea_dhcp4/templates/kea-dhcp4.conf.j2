{# {{ ansible_managed }} (rol kea_dhcp4, R1, sección 7.1) #}
{% set subredes = [] %}
{% for r in kea_dhcp4_redes %}
{%   set red = redes[r] %}
{%   set subred = {
       "id": red.vlan,
       "subnet": red.ipv4,
       "interface": red.interfaz,
       "pools": [{"pool": red.pool4}],
       "valid-lifetime": red.prestamo4,
       "option-data": [{"name": "routers", "data": red.gw4}]
     } %}
{%   set _ = subredes.append(subred) %}
{% endfor %}
{# sw01 informa el nombre del puerto en la subopción 2 (Remote-ID) de la opción 82.
   Cualquier equipo conectado a un puerto de administración recibe una dirección
   del pool de administración #}
{% set clases = [] %}
{% if dhcp_puertos_admin %}
{%   set prueba = dhcp_puertos_admin | map('regex_replace', '^(.*)$', "relay4[2].hex == '\\1'") | join(' or ') %}
{%   set _ = clases.append({"name": "puerto_admin", "test": prueba, "valid-lifetime": dhcp_prestamo_admin}) %}
{%   set _ = clases.append({"name": "puerto_normal", "test": "not member('puerto_admin')"}) %}
{%   for s in subredes %}
{%     if s.interface == redes[kea_dhcp4_red_admin].interfaz %}
{%       set _ = s.update({"pools": [
           {"pool": dhcp_pool_admin, "client-class": "puerto_admin"},
           {"pool": redes[kea_dhcp4_red_admin].pool4, "client-class": "puerto_normal"}
         ]}) %}
{%     endif %}
{%   endfor %}
{% endif %}
{{ {
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": kea_dhcp4_redes | map('extract', redes, 'interfaz') | list,
      "dhcp-socket-type": "raw",
      "service-sockets-max-retries": 12,
      "service-sockets-retry-wait-time": 5000
    },
    "lease-database": {"type": "memfile", "persist": true, "lfc-interval": 3600},
    "option-data": [
      {"name": "domain-name-servers", "data": servicios_kit01.ipv4},
      {"name": "domain-name", "data": dominio},
      {"name": "domain-search", "data": dominio},
      {"name": "ntp-servers", "data": servicios_kit01.ipv4}
    ],
    "client-classes": clases,
    "subnet4": subredes,
    "loggers": [{
      "name": "kea-dhcp4",
      "output_options": [{"output": "stdout", "pattern": "%-5p [%c] %m\n"}],
      "severity": "INFO"
    }]
  }
} | to_nice_json(indent=2) }}
