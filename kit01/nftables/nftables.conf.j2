#!/usr/sbin/nft -f
# Firewall de kit01 (network#4, network#10, D-02, secciones 6.3, 8.4 y 11 del documento)
#
# No usa "flush ruleset": iptables-nft (NetBird y libvirt) tiene sus propias
# tablas (ip filter, ip nat, ...). Cada tabla de este archivo se declara, se
# borra y se vuelve a crear en la misma transacción, así que el archivo se
# puede aplicar las veces que haga falta sin tocar las demás.

define if_wan        = "{{ iface_wan }}"
define if_interna    = "{{ redes.interna.interfaz }}"
define if_comunidad  = "{{ redes.comunidad.interfaz }}"
define if_servidores = "{{ redes.servidores.interfaz }}"
define if_netbird    = "{{ kit01_firewall_if_netbird }}"

define admin4    = {{ admin_ipv4_rango }}
define srv4      = {{ servicios_kit01.ipv4 }}
define srv6      = {{ servicios_kit01.ipv6 }}
define gw_com4   = {{ redes.comunidad.gw4 }}
define gw_com6   = {{ redes.comunidad.gw6 }}
define gw_srv4   = {{ redes.servidores.gw4 }}
define gw_srv6   = {{ redes.servidores.gw6 }}
define red_kit4  = {{ red_kit4 }}
define vms4      = { {{ equipos.clinica01.ipv4 }}, {{ equipos.comunidad01.ipv4 }} }
define clinica4  = {{ equipos.clinica01.ipv4 }}
define clinica6  = {{ equipos.clinica01.ipv6 }}
define comunidad4 = {{ equipos.comunidad01.ipv4 }}
define comunidad6 = {{ equipos.comunidad01.ipv6 }}
define vms6      = { {{ equipos.clinica01.ipv6 }}, {{ equipos.comunidad01.ipv6 }} }
define sw01_4    = {{ equipos.sw01.ipv4 }}
define sw01_6    = {{ equipos.sw01.ipv6 }}
define ula_kit6  = {{ ula_kit6 }}
define wg_puerto = {{ kit01_firewall_wg_puerto }}

table inet filtro
delete table inet filtro

table inet filtro {
	# MAC de la Comunidad que aceptaron el portal cautivo (R5, D-22, 6.4). El
	# servicio del portal las agrega; vencen solas
	set {{ portal_set }} {
		type ether_addr
		flags timeout
		timeout {{ portal_timeout }}
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid counter drop

		# ICMPv6 imprescindible (RFC 4890, F-19); DAD y MLD usan el origen ::
		ip6 saddr { fe80::/10, $ula_kit6 } icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query, mld-listener-report, mld2-listener-report } counter accept
		ip6 saddr :: icmpv6 type { nd-neighbor-solicit, mld2-listener-report } counter accept

		# Eco ICMP: Interna y NetBird (F-01, F-22); Comunidad y Servidores solo hacia su gateway (F-23)
		iifname { $if_interna, $if_netbird } icmp type echo-request counter accept
		iifname $if_interna icmpv6 type echo-request counter accept
		iifname $if_comunidad ip daddr $gw_com4 icmp type echo-request counter accept
		iifname $if_comunidad ip6 daddr { $gw_com6, fe80::1 } icmpv6 type echo-request counter accept
		iifname $if_servidores ip daddr $gw_srv4 icmp type echo-request counter accept
		iifname $if_servidores ip6 daddr { $gw_srv6, fe80::1 } icmpv6 type echo-request counter accept

		# DHCPv4 y DHCPv6 stateless (F-04)
		iifname { $if_interna, $if_comunidad } udp dport 67 counter accept
		iifname { $if_interna, $if_comunidad } ip6 saddr fe80::/10 udp dport 547 counter accept

		# Página del portal cautivo, solo por HTTP, para la Comunidad (F-08)
		iifname $if_comunidad ip daddr $gw_com4 tcp dport 80 counter accept
		iifname $if_comunidad ip6 daddr $gw_com6 tcp dport 80 counter accept

		# DNS y NTP en la IP de servicios .10 (F-03)
		iifname { $if_interna, $if_comunidad, $if_servidores } ip daddr $srv4 meta l4proto { tcp, udp } th dport 53 counter accept
		iifname { $if_interna, $if_comunidad, $if_servidores } ip6 daddr $srv6 meta l4proto { tcp, udp } th dport 53 counter accept
		iifname { $if_interna, $if_comunidad, $if_servidores } ip daddr $srv4 udp dport 123 counter accept
		iifname { $if_interna, $if_comunidad, $if_servidores } ip6 daddr $srv6 udp dport 123 counter accept

		# Logs hacia rsyslog en la IP de servicios, las VMs por TCP (F-15) y sw01 por UDP (F-16)
		iifname $if_servidores ip saddr $vms4 ip daddr $srv4 tcp dport 514 counter accept
		iifname $if_servidores ip6 saddr $vms6 ip6 daddr $srv6 tcp dport 514 counter accept
		iifname $if_interna ip saddr $sw01_4 ip daddr $srv4 udp dport 514 counter accept
		iifname $if_interna ip6 saddr $sw01_6 ip6 daddr $srv6 udp dport 514 counter accept

		# Administración: SSH y monitoreo solo desde admin y NetBird (F-01, F-21)
		iifname $if_interna ip saddr $admin4 tcp dport { 22, 443 } counter accept
		iifname $if_netbird tcp dport { 22, 443 } counter accept

		# Túnel de NetBird (WireGuard) por la WAN
		iifname $if_wan udp dport $wg_puerto counter accept

		# Bloqueado y registrado: la Comunidad hacia la gestión de kit01 (F-20) y el
		# SSH de la Interna que no es admin, por IPv6 de nadie (F-21)
		iifname $if_comunidad tcp dport { 22, 443 } counter goto bloqueo_f20
		iifname $if_interna ip saddr != $admin4 tcp dport 22 counter goto bloqueo_f21
		iifname $if_interna meta nfproto ipv6 tcp dport 22 counter goto bloqueo_f21

		limit rate 10/second burst 50 packets log prefix "fw-drop " level info
		counter
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid counter drop

		# Errores ICMPv6 que IPv6 necesita en tránsito (F-19)
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept

		# Bloqueado y registrado: la Comunidad hacia la Interna y clinica01 (F-20),
		# con portal aceptado o sin él, y el SSH de la Interna hacia las VMs (F-21)
		iifname $if_comunidad oifname $if_interna counter goto bloqueo_f20
		iifname $if_comunidad ip daddr $clinica4 counter goto bloqueo_f20
		iifname $if_comunidad ip6 daddr $clinica6 counter goto bloqueo_f20
		iifname $if_interna oifname $if_servidores tcp dport 22 counter goto bloqueo_f21

		# Interna hacia Internet, solo IPv4 con NAT (F-24)
		iifname $if_interna oifname $if_wan meta nfproto ipv4 counter accept

		# VMs hacia Internet, solo IPv4 con NAT: paquetes e imágenes (F-17)
		iifname $if_servidores oifname $if_wan ip saddr $vms4 tcp dport { 80, 443 } counter accept

		# Interna hacia DHIS2 (443) y los recursos SMB (445) de clinica01 (F-05)
		iifname $if_interna oifname $if_servidores ip daddr $clinica4 tcp dport { 443, 445 } counter accept
		iifname $if_interna oifname $if_servidores ip6 daddr $clinica6 tcp dport { 443, 445 } counter accept

		# Eco desde la Interna hacia las VMs (F-22)
		iifname $if_interna oifname $if_servidores ip daddr $vms4 icmp type echo-request counter accept
		iifname $if_interna oifname $if_servidores ip6 daddr $vms6 icmpv6 type echo-request counter accept

		# Interna hacia la biblioteca, los videos (80) y el registro (443) de comunidad01 (F-07)
		iifname $if_interna oifname $if_servidores ip daddr $comunidad4 tcp dport { 80, 443 } counter accept
		iifname $if_interna oifname $if_servidores ip6 daddr $comunidad6 tcp dport { 80, 443 } counter accept

		# Comunidad que aceptó el portal hacia la biblioteca, los videos y el registro (F-09)
		iifname $if_comunidad oifname $if_servidores ether saddr @{{ portal_set }} ip daddr $comunidad4 tcp dport { 80, 443 } counter accept
		iifname $if_comunidad oifname $if_servidores ether saddr @{{ portal_set }} ip6 daddr $comunidad6 tcp dport { 80, 443 } counter accept

		# Comunidad que aceptó el portal hacia Internet, solo IPv4 con NAT (F-10)
		iifname $if_comunidad oifname $if_wan ether saddr @{{ portal_set }} meta nfproto ipv4 counter accept

		# HTTPS de la Comunidad sin aceptar: se rechaza enseguida, porque el portal va por HTTP
		iifname $if_comunidad ether saddr != @{{ portal_set }} tcp dport 443 counter reject with tcp reset

		limit rate 10/second burst 50 packets log prefix "fw-drop " level info
		counter
	}

	# El HTTP de la Comunidad sin aceptar va al portal en kit01, en IPv4 e IPv6 (6.4)
	chain portal_redireccion {
		type nat hook prerouting priority dstnat; policy accept;

		iifname $if_comunidad ether saddr != @{{ portal_set }} fib daddr type != local meta nfproto ipv4 tcp dport 80 counter dnat ip to $gw_com4
		iifname $if_comunidad ether saddr != @{{ portal_set }} fib daddr type != local meta nfproto ipv6 tcp dport 80 counter dnat ip6 to $gw_com6
	}

	# Salida de kit01. Hacia dentro del kit y por wt0 no se filtra (F-02, F-13,
	# F-14, F-25); hacia Internet solo lo de F-18
	chain output {
		type filter hook output priority filter; policy accept;

		oifname $if_wan jump salida_wan
	}

	# kit01 hacia Internet (F-18): DNS, apt (80), HTTPS y NetBird, que usa
	# WireGuard, STUN e ICE por UDP con puertos variables
	chain salida_wan {
		ct state established,related accept
		meta l4proto udp counter accept
		tcp dport { 53, 80, 443 } counter accept
		meta l4proto { icmp, ipv6-icmp } counter accept
		counter goto bloqueo_f18
	}

	# Bloqueos de la matriz, cada uno con su contador y su prefijo en el log
	chain bloqueo_f18 {
		limit rate 10/second burst 50 packets log prefix "fw-drop F-18 " level info
		counter drop
	}

	chain bloqueo_f20 {
		limit rate 10/second burst 50 packets log prefix "fw-drop F-20 " level info
		counter drop
	}

	chain bloqueo_f21 {
		limit rate 10/second burst 50 packets log prefix "fw-drop F-21 " level info
		counter drop
	}
}

# Entre las VMs (F-11, F-12, sección 6.3). Solo ve lo que br-srv conmuta entre
# sus puertos; lo que va a kit01 o sale por él lo filtra inet filtro. Con
# conntrack, la respuesta de una conexión permitida no abre el camino contrario
table bridge filtro_vms
delete table bridge filtro_vms

table bridge filtro_vms {
	chain forward {
		type filter hook forward priority filter; policy accept;

		# Los demás bridges (br-com) no se tocan
		meta ibrname != $if_servidores accept

		ct state established,related accept
		ct state invalid counter drop

		# Resolución de direcciones entre las VMs; el resto de broadcast y
		# multicast se descarta sin registrar
		ether type arp accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
		meta pkttype { broadcast, multicast } counter drop

		# Formularios: comunidad01 hacia PostgreSQL de clinica01 (F-11)
		ip saddr $comunidad4 ip daddr $clinica4 tcp dport 5432 counter accept
		ip6 saddr $comunidad6 ip6 daddr $clinica6 tcp dport 5432 counter accept

		# Publicación de contenido: clinica01 hacia el SSH de comunidad01 (F-12)
		ip saddr $clinica4 ip daddr $comunidad4 tcp dport 22 counter accept
		ip6 saddr $clinica6 ip6 daddr $comunidad6 tcp dport 22 counter accept

		limit rate 10/second burst 50 packets log prefix "fw-drop br-srv " level info
		counter drop
	}
}

# NAT de salida en una tabla aparte (sección 6.3). No se llama "ip nat" porque
# esa es la tabla de iptables-nft que usan NetBird y libvirt.
table ip nat_kit
delete table ip nat_kit

table ip nat_kit {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname $if_wan ip saddr $red_kit4 counter masquerade
	}
}
