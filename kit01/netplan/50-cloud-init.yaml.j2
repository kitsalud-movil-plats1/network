{# Netplan de kit01 (network#3, D-14, D-15, secciones 6.2, 7 y 8). Rol kit01_red.
   Sin cabecera en el archivo generado, para que sea igual al que ya está en kit01 #}
{% macro con_prefijo(dir, red) %}{{ dir }}/{{ red | split('/') | last }}{% endmacro %}
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ iface_wan }}:
{% if wan.mac is defined %}
      match:
        macaddress: "{{ wan.mac }}"
      set-name: {{ iface_wan }}
{% endif %}
{% if wan.dhcp4 | default(false) %}
      dhcp4: true
{% else %}
      dhcp4: false
      addresses:
        - {{ wan.ipv4 }}
      routes:
        - to: default
          via: {{ wan.gw4 }}
      nameservers:
        addresses:
{% for d in wan.dns %}
          - {{ d }}
{% endfor %}
{% endif %}
      dhcp6: false
      accept-ra: false
    {{ iface_lan }}:
{% if lan_mac is defined %}
      match:
        macaddress: "{{ lan_mac }}"
      set-name: {{ iface_lan }}
{% endif %}
      dhcp4: false
      dhcp6: false
      accept-ra: false
      link-local: []
  dummy-devices:
    srv-dummy0:
      accept-ra: false
      link-local: []
  vlans:
    {{ redes.interna.interfaz }}:
      id: {{ redes.interna.vlan }}
      link: {{ iface_lan }}
      accept-ra: false
      addresses:
        - {{ con_prefijo(redes.interna.gw4, redes.interna.ipv4) }}
        - "{{ con_prefijo(redes.interna.gw6, redes.interna.ipv6) }}"
        - "{{ gw_link_local }}/64"
    lan0.{{ redes.comunidad.vlan }}:
      id: {{ redes.comunidad.vlan }}
      link: {{ iface_lan }}
      accept-ra: false
      link-local: []
  bridges:
    {{ redes.comunidad.interfaz }}:
      interfaces:
        - lan0.{{ redes.comunidad.vlan }}
      parameters:
        stp: false
        forward-delay: 0
      accept-ra: false
      addresses:
        - {{ con_prefijo(redes.comunidad.gw4, redes.comunidad.ipv4) }}
        - "{{ con_prefijo(redes.comunidad.gw6, redes.comunidad.ipv6) }}"
        - "{{ gw_link_local }}/64"
    {{ redes.servidores.interfaz }}:
      interfaces:
        - srv-dummy0
      parameters:
        stp: false
        forward-delay: 0
      accept-ra: false
      addresses:
        - {{ con_prefijo(redes.servidores.gw4, redes.servidores.ipv4) }}
        - {{ con_prefijo(servicios_kit01.ipv4, redes.servidores.ipv4) }}
        - "{{ con_prefijo(redes.servidores.gw6, redes.servidores.ipv6) }}"
        - "{{ con_prefijo(servicios_kit01.ipv6, redes.servidores.ipv6) }}"
        - "{{ gw_link_local }}/64"
